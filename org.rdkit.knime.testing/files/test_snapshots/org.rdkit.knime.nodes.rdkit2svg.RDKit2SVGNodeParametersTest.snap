          },
          "simplifiedStereoGroups" : {
            "configKey" : "simplified_stereo_groups"
          },
          "bondLineWidthDouble" : {
            "configKey" : "bond_line_width_double",
            "deprecatedConfigKeys" : [ {
              "deprecated" : [ [ "bond_line_width" ] ]
            } ]
          },
          "minFontSize" : {
            "configKey" : "min_font_size"
          },
          "maxFontSize" : {
            "configKey" : "max_font_size"
          },
          "annotationFontScale" : {
            "configKey" : "annotation_font_scale"
          }
        }
      }
    }
  },
  "initialUpdates" : [ {
    "scope" : "#/properties/model/properties/inputColumn",
    "providedOptionName" : "possibleValues",
    "values" : [ {
