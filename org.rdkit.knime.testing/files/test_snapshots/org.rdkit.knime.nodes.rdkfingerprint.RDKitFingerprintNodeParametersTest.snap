{
  "data" : {
    "model" : {
      "fingerprintType" : "morgan",
      "removeSourceColumns" : false,
      "numBits" : 1024,
      "radius" : 2,
      "layerFlags" : 7,
      "torsionPathLength" : 4,
      "minPath" : 1,
      "maxPath" : 7,
      "atomPairMinPath" : 1,
      "atomPairMaxPath" : 30,
      "useChirality" : false,
      "rootedOption" : false,
      "atomListColumn" : {
        "specialChoice" : "NONE"
      },
      "includeAtoms" : true
    }
  },
  "schema" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "atomListColumn" : {
            "type" : "object",
            "properties" : {
              "regularChoice" : {
                "type" : "string"
              },
              "specialChoice" : {
                "oneOf" : [ {
                  "const" : "NONE",
                  "title" : "None"
                } ]
              }
            },
            "title" : "Atom list column for rooted fingerprints",
            "description" : "The column containing the atom lists that are necessary when calculating rooted fingerprints. Instead of a list it is also possible to provide an integer column with a single atom index.",
            "default" : {
              "specialChoice" : "NONE"
            }
          },
          "atomPairMaxPath" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "AtomPair max path length",
            "description" : "Maximum length (in bonds) of the atom pair paths to be considered.",
            "default" : 30
          },
          "atomPairMinPath" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "AtomPair min path length",
            "description" : "Minimum length (in bonds) of the atom pair paths to be considered.",
            "default" : 1
          },
          "fingerprintType" : {
            "oneOf" : [ {
              "const" : "morgan",
              "title" : "Morgan"
            }, {
              "const" : "featmorgan",
              "title" : "FeatMorgan"
            }, {
              "const" : "atompair",
              "title" : "AtomPair"
            }, {
              "const" : "torsion",
              "title" : "Torsion"
            }, {
              "const" : "rdkit",
              "title" : "RDKit"
            }, {
              "const" : "avalon",
              "title" : "Avalon"
            }, {
              "const" : "layered",
              "title" : "Layered"
            }, {
              "const" : "maccs",
              "title" : "MACCS"
            }, {
              "const" : "pattern",
              "title" : "Pattern"
            } ],
            "title" : "Fingerprint type",
            "description" : "More details about different RDKit fingerprint implementations can be found here: https://www.rdkit.org/docs/RDKit_Book.html#additional-information-about-the-fingerprints.\n<ul>\n<li><b>Morgan</b>: Circular fingerprint based on the Morgan algorithm and connectivity invariants (ECFP-like).</li>\n<li><b>FeatMorgan</b>: Circular fingerprint based on the Morgan algorithm and feature invariants (FCFP-like).</li>\n<li><b>AtomPair</b>: Atom-pair fingerprint.</li>\n<li><b>Torsion</b>: Topological-torsion fingerprint.</li>\n<li><b>RDKit</b>: Daylight-like topological fingerprint.</li>\n<li><b>Avalon</b>: Fingerprint from the Avalon toolkit (http://sourceforge.net/p/avalontoolkit/).</li>\n<li><b>Layered</b>: An experimental substructure-matching fingerprint (see LayerFlags definition from above).</li>\n<li><b>MACCS</b>: RDKit implementation of the 166 public MACCS keys.</li>\n<li><b>Pattern</b>: Substructure screening fingerprint based on a small number of very generic SMARTS patterns.</li>\n</ul>",
            "default" : "morgan"
          },
          "includeAtoms" : {
            "type" : "boolean",
            "title" : "Include atoms",
            "description" : "Check this option to include the atoms when calculating rooted fingerprints or uncheck to exclude them.",
            "default" : true
          },
          "layerFlags" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "Layer flags",
            "description" : "Which atomic layers should be included. This value is the total of the following layer flag values: 0x01 pure topology, 0x02 bond order, 0x04 atom types, 0x08 presence of rings, 0x10 ring sizes, 0x20 aromaticity. The default value of 7 (0x01 pure topology + 0x02 bond order + 0x04 atom types) allows classic substructure searches.",
            "default" : 7
          },
          "maxPath" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "Max path length",
            "description" : "Maximum length (in bonds) of the paths to be considered.",
            "default" : 7
          },
          "minPath" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "Min path length",
            "description" : "Minimum length (in bonds) of the paths to be considered.",
            "default" : 1
          },
          "molColumn" : {
            "type" : "string",
            "title" : "RDKit mol column",
            "description" : "The column containing reactant molecules."
          },
          "newColumnName" : {
            "type" : "string",
            "title" : "New fingerprint column name",
            "description" : "Name of the fingerprint column in the output table."
          },
          "numBits" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "Num bits",
            "description" : "Number of bits in the fingerprint.",
            "default" : 1024
          },
          "radius" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "Radius",
            "description" : "The radius of the atomic environments considered.",
            "default" : 2
          },
          "removeSourceColumns" : {
            "type" : "boolean",
            "title" : "Remove source column",
            "description" : "Toggles removal of the input RDKit Mol column in the output table.",
            "default" : false
          },
          "rootedOption" : {
            "type" : "boolean",
            "title" : "Create rooted fingerprint",
            "description" : "Check this option to create a rooted fingerprint based on an atom list. This option is not applicable to all fingerprint types.",
            "default" : false
          },
          "torsionPathLength" : {
            "type" : "integer",
            "format" : "int32",
            "title" : "Path length",
            "description" : "Path length to be used (Torsion only).",
            "default" : 4
          },
          "useChirality" : {
            "type" : "boolean",
            "title" : "Use chirality",
            "description" : "If checked, chirality information is taken into account when generating the fingerprint.",
            "default" : false
          }
        }
      }
    }
  },
  "ui_schema" : {
    "elements" : [ {
      "type" : "Control",
      "scope" : "#/properties/model/properties/molColumn",
      "options" : {
        "format" : "dropDown"
      },
      "providedOptions" : [ "possibleValues" ]
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/fingerprintType"
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/newColumnName"
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/removeSourceColumns",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/numBits",
      "options" : {
        "validation" : {
          "max" : {
            "errorMessage" : "The value must not exceed 2147483647.",
            "parameters" : {
              "isExclusive" : false,
              "max" : 2.147483647E9
            }
          },
          "min" : {
            "errorMessage" : "The value must be at least 32.",
            "parameters" : {
              "isExclusive" : false,
              "min" : 32.0
            }
          }
        }
      },
      "rule" : {
        "effect" : "SHOW",
        "condition" : {
          "scope" : "#/properties/model/properties/fingerprintType",
          "schema" : {
            "oneOf" : [ {
              "const" : "morgan"
            }, {
              "const" : "featmorgan"
            }, {
              "const" : "atompair"
            }, {
              "const" : "torsion"
            }, {
              "const" : "rdkit"
            }, {
              "const" : "avalon"
            }, {
              "const" : "layered"
            }, {
              "const" : "pattern"
            } ]
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/radius",
      "options" : {
        "validation" : {
          "max" : {
            "errorMessage" : "The value must not exceed 6.",
            "parameters" : {
              "isExclusive" : false,
              "max" : 6.0
            }
          },
          "min" : {
            "errorMessage" : "The value must be at least 0.",
            "parameters" : {
              "isExclusive" : false,
              "min" : 0.0
            }
          }
        }
      },
      "rule" : {
        "effect" : "SHOW",
        "condition" : {
          "scope" : "#/properties/model/properties/fingerprintType",
          "schema" : {
            "oneOf" : [ {
              "const" : "morgan"
            }, {
              "const" : "featmorgan"
            } ]
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/layerFlags",
      "options" : {
        "validation" : {
          "max" : {
            "errorMessage" : "The value must not exceed 65535.",
            "parameters" : {
              "isExclusive" : false,
              "max" : 65535.0
            }
          },
          "min" : {
            "errorMessage" : "The value must be at least 0.",
            "parameters" : {
              "isExclusive" : false,
              "min" : 0.0
            }
          }
        }
      },
      "rule" : {
        "effect" : "SHOW",
        "condition" : {
          "scope" : "#/properties/model/properties/fingerprintType",
          "schema" : {
            "oneOf" : [ {
              "const" : "layered"
            } ]
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/torsionPathLength",
      "options" : {
        "validation" : {
          "max" : {
            "errorMessage" : "The value must not exceed 10.",
            "parameters" : {
              "isExclusive" : false,
              "max" : 10.0
            }
          },
          "min" : {
            "errorMessage" : "The value must be at least 1.",
            "parameters" : {
              "isExclusive" : false,
              "min" : 1.0
            }
          }
        }
      },
      "rule" : {
        "effect" : "SHOW",
        "condition" : {
          "scope" : "#/properties/model/properties/fingerprintType",
          "schema" : {
            "oneOf" : [ {
              "const" : "torsion"
            } ]
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/minPath",
      "options" : {
        "validation" : {
          "max" : {
            "errorMessage" : "The value must not exceed 10.",
            "parameters" : {
              "isExclusive" : false,
              "max" : 10.0
            }
          },
          "min" : {
            "errorMessage" : "The value must be at least 1.",
            "parameters" : {
              "isExclusive" : false,
              "min" : 1.0
            }
          }
        }
      },
      "rule" : {
        "effect" : "SHOW",
        "condition" : {
          "scope" : "#/properties/model/properties/fingerprintType",
          "schema" : {
            "oneOf" : [ {
              "const" : "rdkit"
            }, {
              "const" : "layered"
            } ]
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/maxPath",
      "options" : {
        "validation" : {
          "max" : {
            "errorMessage" : "The value must not exceed 10.",
            "parameters" : {
              "isExclusive" : false,
              "max" : 10.0
            }
          },
          "min" : {
            "errorMessage" : "The value must be at least 1.",
            "parameters" : {
              "isExclusive" : false,
              "min" : 1.0
            }
          }
        }
      },
      "rule" : {
        "effect" : "SHOW",
        "condition" : {
          "scope" : "#/properties/model/properties/fingerprintType",
          "schema" : {
            "oneOf" : [ {
              "const" : "rdkit"
            }, {
              "const" : "layered"
            } ]
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/atomPairMinPath",
      "options" : {
