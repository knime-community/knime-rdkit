{
  "data" : {
    "model" : {
      "removeSourceColumns" : false,
      "generateInChIKeysOption" : false,
      "extraReturnCodeOption" : false,
      "extraAuxInfoOption" : false,
      "extraMessageOption" : false,
      "extraLogOption" : false,
      "advancedOptions" : ""
    }
  },
  "schema" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "advancedOptions" : {
            "type" : "string",
            "title" : "InChI code generation switches",
            "description" : "Specify here space-separated switches, which need to start with / or - to influence the InChI code generation. Some of them make the resulting InChI code Non-standard. A good overview about possible switches can be found here: <a href=\"https://www.inchi-trust.org/technical-faq-2/#15.14\">https://www.inchi-trust.org/technical-faq-2/#15.14</a>.",
            "default" : ""
          },
          "extraAuxInfoOption" : {
            "type" : "boolean",
            "title" : "Aux info column",
            "description" : "Enable to also generate a column that contains aux information about the InChI code.",
            "default" : false
          },
          "extraInformationColumnNamePrefix" : {
            "type" : "string",
            "title" : "New column name prefix for extra information",
            "description" : "The prefix of column names, which will contain the extra information about InChI code generation."
          },
          "extraLogOption" : {
            "type" : "boolean",
            "title" : "Log column",
            "description" : "Enable to also generate a column that contains a log message of the InChI generation routine.",
            "default" : false
          },
          "extraMessageOption" : {
            "type" : "boolean",
            "title" : "Message column",
            "description" : "Enable to also generate a column that contains a message generated during the InChI generation routine.",
            "default" : false
          },
          "extraReturnCodeOption" : {
            "type" : "boolean",
            "title" : "Return code column",
            "description" : "Enable to also generate a column that contains the return code of the InChI generation routine.",
            "default" : false
          },
          "generateInChIKeysOption" : {
            "type" : "boolean",
            "title" : "Generate also InChI keys",
            "description" : "Enable to also generated InChI Keys.",
            "default" : false
          },
          "inputColumnName" : {
            "type" : "string",
            "title" : "RDKit mol column",
            "description" : "The input column with RDKit Molecules."
          },
          "newInChICodeColumnName" : {
            "type" : "string",
            "title" : "New column name for InChI codes",
            "description" : "The name of the new column, which will contain the InChi code."
          },
          "newInChIKeyColumnName" : {
            "type" : "string",
            "title" : "New column name for InChI keys",
            "description" : "The name of the new column, which will contain the InChi keys."
          },
          "removeSourceColumns" : {
            "type" : "boolean",
            "title" : "Remove source column",
            "description" : "Enable to remove the specified source column from the result table.",
            "default" : false
          }
        }
      }
    }
  },
  "ui_schema" : {
    "elements" : [ {
      "type" : "Control",
      "scope" : "#/properties/model/properties/inputColumnName",
      "options" : {
        "format" : "dropDown"
      },
      "providedOptions" : [ "possibleValues" ]
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/removeSourceColumns",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/newInChICodeColumnName"
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/generateInChIKeysOption",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/newInChIKeyColumnName",
      "rule" : {
        "effect" : "ENABLE",
        "condition" : {
          "scope" : "#/properties/model/properties/generateInChIKeysOption",
          "schema" : {
            "const" : true
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/advancedOptions",
      "options" : {
        "rows" : 5,
        "format" : "textArea",
        "isAdvanced" : true
      }
    }, {
      "label" : "Extra InChI Generation Information",
      "type" : "Section",
      "elements" : [ {
        "type" : "Control",
        "scope" : "#/properties/model/properties/extraInformationColumnNamePrefix"
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/extraReturnCodeOption",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/extraAuxInfoOption",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/extraMessageOption",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/extraLogOption",
        "options" : {
          "format" : "checkbox"
        }
      } ]
    } ]
  },
  "persist" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "inputColumnName" : {
            "configKey" : "input_column"
          },
          "removeSourceColumns" : {
            "configKey" : "remove_source_columns"
          },
          "newInChICodeColumnName" : {
            "configKey" : "new_inchi_code_column_name"
          },
          "generateInChIKeysOption" : {
            "configKey" : "generate_inchi_keys"
          },
          "newInChIKeyColumnName" : {
            "configKey" : "new_inchi_key_column_name"
          },
          "extraInformationColumnNamePrefix" : {
            "configKey" : "new_extra_info_column_name_prefix"
          },
          "extraReturnCodeOption" : {
            "configKey" : "generate_return_code"
          },
          "extraAuxInfoOption" : {
            "configKey" : "generate_aux_info"
          },
          "extraMessageOption" : {
            "configKey" : "generate_message"
          },
          "extraLogOption" : {
            "configKey" : "generate_log"
          },
          "advancedOptions" : {
            "configKey" : "advanced_opions"
          }
        }
      }
    }
  },
  "initialUpdates" : [ {
    "scope" : "#/properties/model/properties/inputColumnName",
    "providedOptionName" : "possibleValues",
    "values" : [ {
      "indices" : [ ],
      "value" : [ {
        "id" : "Molecule",
        "text" : "Molecule",
        "type" : {
          "id" : "org.rdkit.knime.types.RDKitMolValue",
          "text" : "RDKit Molecule"
        }
      } ]
    } ]
  } ],
  "globalUpdates" : [ {
    "trigger" : {
      "scope" : "#/properties/model/properties/inputColumnName"
    },
    "dependencies" : [ "#/properties/model/properties/inputColumnName", "#/properties/model/properties/newInChICodeColumnName", "#/properties/model/properties/newInChIKeyColumnName", "#/properties/model/properties/removeSourceColumns" ]
  } ]
}