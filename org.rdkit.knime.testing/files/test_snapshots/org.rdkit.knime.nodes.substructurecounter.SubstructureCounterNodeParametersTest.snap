{
  "data" : {
    "model" : {
      "uniqueMatchesOnly" : true,
      "useChirality" : false,
      "useEnhancedStereo" : false,
      "useQueryNameColumn" : false,
      "countTotalHits" : false,
      "countTotalHitsColumn" : "Total hits",
      "trackQueryTags" : false,
      "trackQueryTagsColumn" : "Query tags"
    }
  },
  "schema" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "countTotalHits" : {
            "type" : "boolean",
            "title" : "Add total hits count column",
            "description" : "Select this option to add a column that contains the accumulated hits count of all hits.",
            "default" : false
          },
          "countTotalHitsColumn" : {
            "type" : "string",
            "title" : "New column name for total hits count",
            "description" : "If the last option is enabled the name for the new column must be specified here.",
            "default" : "Total hits"
          },
          "inputColumn" : {
            "type" : "string",
            "title" : "RDKit mol column",
            "description" : "The input column with RDKit Molecules."
          },
          "queryInputColumn" : {
            "type" : "string",
            "title" : "Input query column",
            "description" : "The name of the column in second table containing query molecules which will act as substructure for the input molecules."
          },
          "queryNameColumn" : {
            "type" : "string",
            "title" : "Column with names for header titles",
            "description" : "If the last option is enabled the column with the query names must be selected here."
          },
          "trackQueryTags" : {
            "type" : "boolean",
            "title" : "Add column with tags for matching queries",
            "description" : "Select this option to add a column that contains a collection of all tags (SMILES, SMARTS values or tags taken from header titles column) for the matching queries. This can be useful for further processing.",
            "default" : false
          },
          "trackQueryTagsColumn" : {
            "type" : "string",
            "title" : "New column name for tags",
            "description" : "If the last option is enabled the name for the new column must be specified here.",
            "default" : "Query tags"
          },
          "uniqueMatchesOnly" : {
            "type" : "boolean",
            "title" : "Count unique matches only",
            "description" : "This option is selected if user requires unique matches of the query molecule in an input molecule.",
            "default" : true
          },
          "useChirality" : {
            "type" : "boolean",
            "title" : "Use chirality when matching",
            "description" : "If this is set, information about stereochemistry will be used in the substructure search.",
            "default" : false
          },
          "useEnhancedStereo" : {
            "type" : "boolean",
            "title" : "Use enhanced stereochemistry when matching",
            "description" : "If this is set, information about enhanced stereochemistry will be used in the substructure search.",
            "default" : false
          },
          "useQueryNameColumn" : {
            "type" : "boolean",
            "title" : "Instead of query molecules use names as result header titles (and tags)",
            "description" : "Select this option to allow the node to use names specified in the query table as column title for the resulting count columns and tags. If disabled, it will use the SMILES or SMARTS value as title.",
            "default" : false
          }
        }
      }
    }
  },
  "ui_schema" : {
    "elements" : [ {
      "type" : "Control",
      "scope" : "#/properties/model/properties/inputColumn",
      "options" : {
        "format" : "dropDown"
      },
      "providedOptions" : [ "possibleValues" ]
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/queryInputColumn",
      "options" : {
        "format" : "dropDown"
      },
      "providedOptions" : [ "possibleValues" ]
    }, {
      "label" : "Search",
      "type" : "Section",
      "elements" : [ {
        "type" : "Control",
        "scope" : "#/properties/model/properties/uniqueMatchesOnly",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/useChirality",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/useEnhancedStereo",
        "options" : {
          "format" : "checkbox"
        },
        "rule" : {
          "effect" : "ENABLE",
          "condition" : {
            "scope" : "#/properties/model/properties/useChirality",
            "schema" : {
              "const" : true
            }
          }
        }
      } ]
    }, {
      "label" : "Output",
      "type" : "Section",
      "elements" : [ {
        "type" : "Control",
        "scope" : "#/properties/model/properties/useQueryNameColumn",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/queryNameColumn",
        "options" : {
          "format" : "dropDown"
        },
        "providedOptions" : [ "possibleValues" ],
        "rule" : {
          "effect" : "ENABLE",
          "condition" : {
            "scope" : "#/properties/model/properties/useQueryNameColumn",
            "schema" : {
              "const" : true
            }
          }
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/countTotalHits",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/countTotalHitsColumn",
        "rule" : {
          "effect" : "ENABLE",
          "condition" : {
            "scope" : "#/properties/model/properties/countTotalHits",
            "schema" : {
              "const" : true
            }
          }
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/trackQueryTags",
        "options" : {
          "format" : "checkbox"
        }
      }, {
        "type" : "Control",
        "scope" : "#/properties/model/properties/trackQueryTagsColumn",
        "rule" : {
          "effect" : "ENABLE",
          "condition" : {
            "scope" : "#/properties/model/properties/trackQueryTags",
            "schema" : {
              "const" : true
            }
          }
        }
      } ]
    } ]
  },
