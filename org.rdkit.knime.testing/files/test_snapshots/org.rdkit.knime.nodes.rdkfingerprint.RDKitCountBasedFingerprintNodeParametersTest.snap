          },
          "radius" : {
            "configKey" : "radius"
          },
          "torsionPathLength" : {
            "configKey" : "torsion_path_length"
          },
          "atomPairMinPath" : {
            "configKey" : "atompairs_min_path"
          },
          "atomPairMaxPath" : {
            "configKey" : "atompairs_max_path"
          },
          "useChirality" : {
            "configKey" : "use_chirality"
          },
          "isRooted" : {
            "configKey" : "is_rooted"
          },
          "atomListColumn" : {
            "configPaths" : [ [ "atom_list_column" ] ]
          },
          "includeAtoms" : {
            "configKey" : "include_atoms"
          }
        }
