  "globalUpdates" : [ {
    "trigger" : {
      "scope" : "#/properties/model/properties/smilesColumn"
    },
    "dependencies" : [ "#/properties/model/properties/newColumnName", "#/properties/model/properties/removeSourceColumns", "#/properties/model/properties/smilesColumn" ]
  } ]
