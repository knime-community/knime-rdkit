<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.knime.org/2008/09/XMLConfig" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.knime.org/2008/09/XMLConfig http://www.knime.org/XMLConfig_2008_09.xsd" key="test">
    <entry key="input_column" type="xstring" value="Molecule"/>
    <entry key="new_column_name" type="xstring" value="Molecule Test (Highlighting)"/>
    <config key="highlighting">
        <entry key="count" type="xint" value="3"/>
        <entry key="select_0" type="xboolean" value="true"/>
        <entry key="type_0" type="xstring" value="Atoms"/>
        <entry key="input_column_0" type="xstring" value="List*(LongCol)"/>
        <entry key="color_0" type="xstring" value="0x999900"/>
        <entry key="neighborhood_0" type="xboolean" value="true"/>
        <entry key="select_1" type="xboolean" value="false"/>
        <entry key="type_1" type="xstring" value="Atoms"/>
        <entry key="input_column_1" type="xstring" value="List*(LongCol) (#1)"/>
        <entry key="color_1" type="xstring" value="0xFF3333"/>
        <entry key="neighborhood_1" type="xboolean" value="false"/>
        <entry key="select_2" type="xboolean" value="true"/>
        <entry key="type_2" type="xstring" value="Atoms"/>
        <entry key="input_column_2" type="xstring" isnull="true" value=""/>
        <entry key="color_2" type="xstring" value="0x660066"/>
        <entry key="neighborhood_2" type="xboolean" value="true"/>
    </config>
</config>
