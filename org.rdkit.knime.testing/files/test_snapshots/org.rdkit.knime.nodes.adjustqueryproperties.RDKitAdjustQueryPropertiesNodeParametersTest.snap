      "options" : {
        "format" : "twinList",
        "includedLabel" : "Use",
        "excludedLabel" : "Do not use"
      },
      "providedOptions" : [ "possibleValues" ],
      "rule" : {
        "effect" : "ENABLE",
        "condition" : {
          "scope" : "#/properties/model/properties/adjustRingCount",
          "schema" : {
            "const" : true
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/makeAtomsGeneric",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/makeAtomsGenericFlags",
      "options" : {
        "format" : "twinList",
        "includedLabel" : "Use",
        "excludedLabel" : "Do not use"
      },
      "providedOptions" : [ "possibleValues" ],
      "rule" : {
        "effect" : "ENABLE",
        "condition" : {
          "scope" : "#/properties/model/properties/makeAtomsGeneric",
          "schema" : {
            "const" : true
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/makeBondsGeneric",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/makeBondsGenericFlags",
      "options" : {
        "format" : "twinList",
        "includedLabel" : "Use",
        "excludedLabel" : "Do not use"
      },
      "providedOptions" : [ "possibleValues" ],
      "rule" : {
        "effect" : "ENABLE",
        "condition" : {
          "scope" : "#/properties/model/properties/makeBondsGeneric",
          "schema" : {
            "const" : true
          }
        }
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/makeDummiesQueries",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/aromatizeIfPossible",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/adjustConjugatedFiveRings",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/setMDLFiveRingAromaticity",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/adjustSingleBondsToDegree1Neighbors",
      "options" : {
