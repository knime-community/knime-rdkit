      "options" : {
        "format" : "twinList",
        "includedLabel" : "Use",
        "excludedLabel" : "Do not use"
      },
      "providedOptions" : [ "possibleValues" ],
      "rule" : {
        "effect" : "ENABLE",
        "condition" : {
          "scope" : "#/properties/model/properties/adjustDegree",
          "schema" : {
            "const" : true
          }
        }
      }
    }, {
      "type" : "Control",
