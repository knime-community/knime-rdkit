{
  "data" : {
    "model" : {
      "removeSourceColumns" : false,
      "adjustDegree" : true,
      "adjustDegreeFlags" : [ "ADJUST_IGNORECHAINS", "ADJUST_IGNOREDUMMIES" ],
      "adjustRingCount" : false,
      "adjustRingCountFlags" : [ "ADJUST_IGNORECHAINS", "ADJUST_IGNOREDUMMIES" ],
      "makeAtomsGeneric" : false,
      "makeAtomsGenericFlags" : [ ],
      "makeBondsGeneric" : false,
      "makeBondsGenericFlags" : [ ],
      "makeDummiesQueries" : true,
      "aromatizeIfPossible" : true,
      "adjustConjugatedFiveRings" : false,
      "setMDLFiveRingAromaticity" : false,
      "adjustSingleBondsToDegree1Neighbors" : false,
      "adjustSingleBondsBetweenAromaticAtoms" : false,
      "useStereoCareForBonds" : false
    }
  },
  "schema" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "adjustConjugatedFiveRings" : {
            "type" : "boolean",
            "title" : "Adjust conjugated 5 rings",
            "description" : "Sets bond queries in conjugated five-rings to SINGLE|DOUBLE|AROMATIC.\n",
            "default" : false
          },
          "adjustDegree" : {
            "type" : "boolean",
            "title" : "Adjust degree",
            "description" : "Enable so that modified atoms have an explicit-degree query added based on their degree in the query.\n",
            "default" : true
          },
          "adjustDegreeFlags" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "title" : "Adjust degree flags",
            "description" : "Control which atoms have a degree query added.",
            "default" : [ "ADJUST_IGNORECHAINS", "ADJUST_IGNOREDUMMIES" ]
          },
          "adjustRingCount" : {
            "type" : "boolean",
            "title" : "Adjust ring count",
            "description" : "Enable so that modified atoms have a ring-count query added based on their ring count in the query.\n",
            "default" : false
          },
          "adjustRingCountFlags" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "title" : "Adjust ring count flags",
            "description" : "Control which atoms have a ring-count query added.",
            "default" : [ "ADJUST_IGNORECHAINS", "ADJUST_IGNOREDUMMIES" ]
          },
          "adjustSingleBondsBetweenAromaticAtoms" : {
            "type" : "boolean",
            "title" : "Adjust single bonds between aromatic atoms",
            "description" : "Sets non-ring single bonds between two aromatic atoms to SINGLE|AROMATIC.\n",
            "default" : false
          },
          "adjustSingleBondsToDegree1Neighbors" : {
            "type" : "boolean",
            "title" : "Adjust single bonds to degree 1 neighbors",
            "description" : "Sets single bonds between aromatic atoms and degree one neighbors to SINGLE|AROMATIC.\n",
            "default" : false
          },
          "aromatizeIfPossible" : {
            "type" : "boolean",
            "title" : "Aromatize if possible",
            "description" : "Perceive and set aromaticity.",
            "default" : true
          },
          "inputColumn" : {
            "type" : "string",
            "title" : "RDKit Mol column",
            "description" : "The input column with molecules to be used as queries."
          },
          "makeAtomsGeneric" : {
            "type" : "boolean",
            "title" : "Make atoms generic",
            "description" : "Convert atoms to any-atom queries.",
            "default" : false
          },
          "makeAtomsGenericFlags" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "title" : "Make atoms generic flags",
            "description" : "Control which atoms are converted to any-atom queries.",
            "default" : [ ]
          },
          "makeBondsGeneric" : {
            "type" : "boolean",
            "title" : "Make bonds generic",
            "description" : "Convert bonds to any-bond queries.",
            "default" : false
          },
          "makeBondsGenericFlags" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "title" : "Make bonds generic flags",
            "description" : "Control which bonds are converted to any-bond queries.",
            "default" : [ ]
          },
          "makeDummiesQueries" : {
            "type" : "boolean",
            "title" : "Make dummies queries",
            "description" : "Enable so that dummy atoms that do not have a specified isotope are converted to any-atom queries.\n",
            "default" : true
          },
          "newColumnName" : {
            "type" : "string",
            "title" : "New column name",
            "description" : "The name of the new column which will contain the tuned queries as RDKit Molecules.\n"
          },
          "removeSourceColumns" : {
            "type" : "boolean",
            "title" : "Remove source column",
            "description" : "Set to true to remove the specified source column from the result table.\n",
            "default" : false
          },
          "setMDLFiveRingAromaticity" : {
            "type" : "boolean",
            "title" : "Set MDL 5 ring aromaticity",
            "description" : "Uses the 5-ring aromaticity behavior of the (former) MDL software as documented in the Chemical\nRepresentation Guide.\n",
            "default" : false
          },
          "useStereoCareForBonds" : {
            "type" : "boolean",
            "title" : "Use stereo care for bonds",
            "description" : "Remove stereochemistry info from double bonds that do not have the stereoCare property set.\n",
            "default" : false
          }
        }
      }
    }
  },
  "ui_schema" : {
    "elements" : [ {
      "type" : "Control",
      "scope" : "#/properties/model/properties/inputColumn",
      "options" : {
        "format" : "dropDown"
      },
      "providedOptions" : [ "possibleValues" ]
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/newColumnName"
    }, {
      "type" : "Control",
