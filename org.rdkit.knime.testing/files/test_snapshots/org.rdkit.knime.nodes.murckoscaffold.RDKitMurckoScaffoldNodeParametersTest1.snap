{
  "data" : {
    "model" : {
      "inputColumnName" : "Molecule",
      "newColumnName" : "Molecule Test (Murcko)",
      "removeSourceColumns" : true,
      "doFrameworks" : false
    }
  },
  "schema" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "doFrameworks" : {
            "type" : "boolean",
            "title" : "Create frameworks",
            "description" : "If checked, generic Murcko frameworks are generated (all atoms replaced by carbon, all bonds replaced by\nsingle bonds) instead of standard Murcko scaffolds.\n",
            "default" : false
          },
          "inputColumnName" : {
            "type" : "string",
            "title" : "RDKit mol column",
            "description" : "The column containing RDKit molecules for which the Murcko scaffold will be computed.\n"
          },
          "newColumnName" : {
            "type" : "string",
            "title" : "New column name",
            "description" : "Name of the new column appended to the output table containing the Murcko scaffold.\n"
          },
          "removeSourceColumns" : {
            "type" : "boolean",
            "title" : "Remove source column",
            "description" : "If checked, the input RDKit mol column is removed from the output table.\n",
            "default" : false
          }
        }
      }
    }
  },
  "ui_schema" : {
    "elements" : [ {
      "type" : "Control",
      "scope" : "#/properties/model/properties/inputColumnName",
      "options" : {
        "format" : "dropDown"
      },
      "providedOptions" : [ "possibleValues" ]
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/newColumnName"
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/removeSourceColumns",
      "options" : {
        "format" : "checkbox"
      }
    }, {
      "type" : "Control",
      "scope" : "#/properties/model/properties/doFrameworks",
      "options" : {
        "format" : "checkbox"
      }
    } ]
  },
  "persist" : {
    "type" : "object",
    "properties" : {
      "model" : {
        "type" : "object",
        "properties" : {
          "inputColumnName" : {
            "configPaths" : [ [ "input_column" ] ]
          },
          "newColumnName" : {
            "configKey" : "new_column_name"
          },
          "removeSourceColumns" : {
            "configKey" : "remove_source_columns"
          },
          "doFrameworks" : {
            "configKey" : "do_frameworks"
          }
        }
      }
    }
  },
  "initialUpdates" : [ {
    "scope" : "#/properties/model/properties/inputColumnName",
    "providedOptionName" : "possibleValues",
    "values" : [ {
      "indices" : [ ],
      "value" : [ {
        "id" : "Molecule",
        "text" : "Molecule",
        "type" : {
          "id" : "org.rdkit.knime.types.RDKitMolValue",
          "text" : "RDKit Molecule"
        }
      } ]
    } ]
  } ],
  "globalUpdates" : [ {
    "trigger" : {
      "scope" : "#/properties/model/properties/inputColumnName"
    },
    "dependencies" : [ "#/properties/model/properties/inputColumnName", "#/properties/model/properties/newColumnName", "#/properties/model/properties/removeSourceColumns" ]
  } ]
}