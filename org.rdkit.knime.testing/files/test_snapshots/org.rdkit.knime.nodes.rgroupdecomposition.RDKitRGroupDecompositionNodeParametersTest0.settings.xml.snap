<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.knime.org/2008/09/XMLConfig" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.knime.org/2008/09/XMLConfig http://www.knime.org/XMLConfig_2008_09.xsd" key="test">
    <entry key="input_column" type="xstring" value="Molecule"/>
    <entry key="cores_input_column" type="xstring" value="Molecule"/>
    <entry key="strict_parsing" type="xboolean" value="true"/>
    <entry key="smarts_value" type="xstring" value=""/>
    <entry key="add_matching_smarts_core" type="xboolean" value="true"/>
    <entry key="new_matching_smarts_core_column_name" type="xstring" value="Corestest"/>
    <entry key="add_matching_explicit_core" type="xboolean" value="true"/>
    <entry key="new_matching_explicit_core_column_name" type="xstring" value="Explicit Coretest"/>
    <entry key="use_atom_maps_for_explicit_core" type="xboolean" value="false"/>
    <entry key="use_r_labels_for_explicit_core" type="xboolean" value="true"/>
    <entry key="remove_empty_columns" type="xboolean" value="true"/>
    <entry key="fail_for_no_match" type="xboolean" value="false"/>
    <config key="labels">
        <entry key="array-size" type="xint" value="2"/>
        <entry key="0" type="xstring" value="AutoDetect"/>
        <entry key="1" type="xstring" value="AtomIndexLabels"/>
    </config>
    <entry key="matching_strategy" type="xstring" value="GA"/>
    <config key="labeling">
        <entry key="array-size" type="xint" value="1"/>
        <entry key="0" type="xstring" value="AtomMap"/>
    </config>
    <entry key="core_alignment" type="xstring" value="None"/>
    <entry key="match_only_at_rgroups" type="xboolean" value="true"/>
    <entry key="remove_hydrogen_only_rgroups" type="xboolean" value="true"/>
    <entry key="remove_hydrogens_post_match" type="xboolean" value="false"/>
</config>
