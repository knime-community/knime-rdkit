      "value" : [ {
        "id" : "fail",
        "text" : "Fail"
      }, {
        "id" : "overwrite",
        "text" : "Overwrite"
      } ]
    } ]
  }, {
    "scope" : "#/properties/model/properties/prevInputColumnString",
    "values" : [ {
      "indices" : [ ],
      "value" : "Molecule"
    } ]
  }, {
    "scope" : "#/properties/model/properties/switches",
    "providedOptionName" : "possibleValues",
    "values" : [ {
      "indices" : [ ],
      "value" : [ {
        "id" : "cc",
        "text" : "cc - Check for collisions"
      }, {
        "id" : "cs",
        "text" : "cs - Check stereo conventions"
      }, {
        "id" : "da",
        "text" : "da - Convert atom text strings to properties"
      }, {
        "id" : "dg",
        "text" : "dg - Convert ISIS groups to S-Groups"
      }, {
        "id" : "ds",
        "text" : "ds - Convert CPSS STEXT to data fields"
      }, {
        "id" : "dw",
        "text" : "dw - Squeeze whitespace out of identifiers"
      }, {
        "id" : "dz",
        "text" : "dz - Strip most of the trailing zeros"
      }, {
        "id" : "tm",
        "text" : "tm - Split off minor fragments"
      } ]
    } ]
  } ],
  "globalUpdates" : [ {
    "trigger" : {
      "scope" : "#/properties/model/properties/inputColumn"
    },
    "dependencies" : [ "#/properties/model/properties/failedErrorMessagesColumn", "#/properties/model/properties/failedFlagsColumn", "#/properties/model/properties/inputColumn", "#/properties/model/properties/passedCorrectedStructureColumn", "#/properties/model/properties/passedFlagsColumn", "#/properties/model/properties/passedWarningMessagesColumn", "#/properties/model/properties/prevInputColumnString" ]
  } ]
}