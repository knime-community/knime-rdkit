          },
          "augmentedAtomsConfigFileSwitch" : {
            "deprecatedConfigKeys" : [ {
              "deprecated" : [ ]
            } ]
          },
          "augmentedAtomsConfigFile" : {
            "configPaths" : [ [ "augmented_atoms_configuration_file", "path" ] ]
          },
